                    #print(min_value,max_value)
                    idx = 0
                    for k in graph[curr][j]:
                        
                        #print(type(graph[curr][j][k]))
                        norm = float((graph[curr][j][k] - min_value[idx])/(max_value[idx]-min_value[idx]))
