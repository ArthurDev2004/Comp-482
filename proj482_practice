                 'B':{'cost':inf, 'pred':[]}, 
                 'C':{'cost':inf, 'pred':[]}, 
                 'D':{'cost':inf, 'pred':[]}, 
                 'E':{'cost':inf, 'pred':[]}, 
                 'F':{'cost':inf, 'pred':[]}
                 }
    node_data[src]['cost'] = 0
    visited = []
    norm_weight_list = []
